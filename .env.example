# ── Banco da janela quente ──────────────────────────────────────────────────
# Duas opções, e RAC_DB_DSN tem precedência sobre o Supabase quando preenchido.
#
# (a) Postgres direto (Aiven/Neon/VM) — o caminho da migração de Set/2026.
#     Ver docs/MIGRACAO_AIVEN.md. Mantenha o ?sslmode=require do provedor:
#     sem ele a conexão cai com uma mensagem que não diz que o problema é TLS.
RAC_DB_DSN=postgresql://avnadmin:SENHA@pg-xxxxx.aivencloud.com:12345/defaultdb?sslmode=require
#
# RAC_DB_BACKEND força o lado: auto (padrão, decide pelo DSN), postgres, supabase.
# RAC_DB_BACKEND=auto

# (b) Supabase via API REST — o caminho original.
SUPABASE_URL=https://[YOUR-REF].supabase.co
SUPABASE_KEY=your_service_role_key

# Conexão Postgres DIRETA do Supabase (senha em Project Settings → Database).
# Lida por `scripts/evacuate_pricetrack.py` (a cota derruba o PostgREST, não o
# Postgres) e pelo backend DSN do pricetrack_importer. NÃO seleciona o backend
# principal: quem faz isso é RAC_DB_DSN.
# Para copiar as tabelas de referência, o DSN vai por argumento:
#   python scripts/db_migrate_hot.py --referencias --dsn-origem "<este DSN>"
# SUPABASE_DSN=postgresql://postgres:SENHA@db.[YOUR-REF].supabase.co:5432/postgres

# ── Anthropic (opcional — Competitive Intelligence no dashboard) ─────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── PriceTrack API — token do header "token" ────────────────────────────────
# Encontre em: PriceTrack → Configurações → API
# NUNCA versione o valor real — use apenas o .env local (gitignored) ou
# GitHub Secrets. Se uma key já foi commitada, ROTACIONE no PriceTrack.
PRICETRACK_API_KEY=your_pricetrack_api_key

# Ajustes opcionais do cliente pricetrack_api/ (defaults de produção):
# PRICETRACK_BASE_URL=https://api.pricetrack.com.br
# PRICETRACK_EXPORT_THRESHOLD_ROWS=50000   # acima disso, coleta via export bulk
# PRICETRACK_PAGE_TAKE=100                 # take dos endpoints paginados
# PRICETRACK_MAX_RETRIES=5                 # retries com backoff exponencial
# PRICETRACK_POLL_INTERVAL_SECONDS=30      # intervalo de polling dos exports
# PRICETRACK_POLL_TIMEOUT_SECONDS=7200     # timeout por export (2h)
# PRICETRACK_MAX_CONCURRENT_EXPORTS=3      # limite da API por organização

# ── Telegram / N8N (opcional — notificações de coleta) ───────────────────────
# TELEGRAM_BOT_TOKEN=
# N8N_TELEGRAM_CHAT_ID=
# N8N_WEBHOOK_URL=

# ── Analista exibido nos relatórios (opcional) ───────────────────────────────
# ANALYST_NAME="Bot Automático Python"

# ── Histórico frio (Parquet) — Google Drive ou disco ─────────────────────────
# Arquitetura híbrida: o Supabase guarda a janela QUENTE (últimos N dias) e o
# histórico completo vive em Parquet no Drive. A gravação é dupla e
# independente — se o banco estiver restrito por cota, o dia ainda entra no
# histórico. Setup: python scripts/gdrive_setup.py --client-secrets seu.json
# Documentação: docs/HISTORICO_DRIVE.md
#
# RAC_HISTORY=on                  # 'off' desliga a gravação do histórico
# RAC_HISTORY_BACKEND=auto        # auto | drive | local
# RAC_HISTORY_DIR=data/history    # destino local (e cache das partições do Drive)
# RAC_HOT_WINDOW_DAYS=15          # dias mantidos no Supabase antes de migrar
# RAC_DRIVE_CSV=on                # espelha o CSV cru da coleta em csv_coletas/
#                                 # no Drive (o Parquet não abre no Excel)
#
# ---------------------------------------------------------------------------
# Amazon — buy box via PDP (DESLIGADA por padrão)
# ---------------------------------------------------------------------------
# A SERP da Amazon não expõe "Vendido por" — só o PDP. Sem isto, `Buy Box
# Seller` da Amazon fica vazio (medido em 0% sobre 8.058 registros em
# 10/08/2026), porque o scraper se recusa a marcar "Amazon/1P" por omissão e
# criar vitória fantasma no share of buy box.
#
# Ligar custa 1 requisição por ASIN novo, na plataforma mais agressiva em
# anti-bot do conjunto. O cache (data/amazon_sellers.json) amortiza entre
# execuções e o teto abaixo limita o risco: batendo o limite, os demais
# registros seguem sem buy box em vez de arriscar derrubar a coleta.
# Recomendado subir o teto aos poucos, observando o log de bloqueio.
#
# RAC_AMAZON_PDP_BUYBOX=1         # 1 liga a resolução (ausente = desligada)
# RAC_AMAZON_PDP_BUDGET=40        # máx. de PDPs por execução do scraper
#
# Credenciais do Drive — NUNCA versione os valores reais.
# GDRIVE_FOLDER_ID=
# GDRIVE_CLIENT_ID=
# GDRIVE_CLIENT_SECRET=
# GDRIVE_REFRESH_TOKEN=
# Alternativa para Google Workspace com Shared Drive (conta de serviço):
# GDRIVE_SERVICE_ACCOUNT_JSON=/caminho/service_account.json
