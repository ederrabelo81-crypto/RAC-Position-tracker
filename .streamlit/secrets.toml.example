# .streamlit/secrets.toml.example
#
# Copie este arquivo para .streamlit/secrets.toml (nunca faça commit do original
# — o real é ignorado pelo .gitignore; preencha só com os valores reais lá).
# No Streamlit Community Cloud use: Settings → Secrets → cole o conteúdo abaixo
# com os valores reais preenchidos.
#
# IMPORTANTE: chaves no TOPO do arquivo, sem seção [default] — o código
# (`app.py::_resolve_secret`, `pricetrack_dashboard/app.py::_bridge_secrets_to_env`)
# lê via `st.secrets.get("NOME")` direto, que não enxerga chaves aninhadas
# dentro de uma seção. Única exceção: GDRIVE_SERVICE_ACCOUNT_JSON pode ser
# uma tabela cujo NOME é a própria chave (ver o bloco do Drive abaixo) —
# `_resolve_secret` serializa a tabela inteira em JSON.
#
# Referência: https://docs.streamlit.io/deploy/streamlit-community-cloud/deploy-your-app/secrets-management

SUPABASE_URL       = "https://SEU-PROJETO.supabase.co"
# service_role, não anon: a escrita da coleta exige service_role (uma key
# anon grava CSV/GDrive e pula o Supabase em silêncio — ver README/CLAUDE.md).
SUPABASE_KEY       = "sua-service-role-key-aqui"
PRICETRACK_API_KEY = "sua-key-do-pricetrack-aqui"

# Histórico frio (Parquet no Google Drive) — OBRIGATÓRIO para ver mais que a
# janela quente. O Supabase guarda só os últimos RAC_HOT_WINDOW_DAYS dias; o
# resto (preço, buy box, posição) mora no Drive. Sem GDRIVE_FOLDER_ID o painel
# lê o disco do container, que é vazio, e mostra só 2 dias — a barra lateral
# acusa "Histórico (Parquet): 🔴 não configurado". Use os MESMOS valores do
# .env do PC coletor (gerados por `python scripts/gdrive_setup.py`).
GDRIVE_FOLDER_ID     = "id-da-pasta-raiz-do-historico"
GDRIVE_CLIENT_ID     = "xxxx.apps.googleusercontent.com"
GDRIVE_CLIENT_SECRET = "seu-client-secret"
GDRIVE_REFRESH_TOKEN = "seu-refresh-token"
# Alternativa ao OAuth (Workspace + Shared Drive): conta de serviço. Forma
# recomendada — tabela TOML, no FIM do arquivo (toda chave abaixo de um
# cabeçalho [..] passa a pertencer a ele):
#   [GDRIVE_SERVICE_ACCOUNT_JSON]
#   type = "service_account"
#   private_key = "-----BEGIN PRIVATE KEY-----\n..."
#   client_email = "..."
# Como JSON numa string, use aspas SIMPLES do TOML (string literal):
#   GDRIVE_SERVICE_ACCOUNT_JSON = '{"type": "service_account", ...}'
# Com aspas duplas o TOML converte cada \n da private_key em quebra de linha
# real e o json.loads recusa ("GDRIVE_SERVICE_ACCOUNT_JSON inválido").
RAC_HOT_WINDOW_DAYS  = "2"
